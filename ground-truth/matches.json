    "truck-swap": "White semi at open becomes green box truck at departure (flash, qwen x2, pro, gemma, pegasus)",
    "truck-reflection": "Waitress reflection wrongly rendered on truck trailer side (flash, pro)",
    "meal-before-served": "Man has plated meal at night before waitress serves it in the morning (qwen, gemma)",
    "garbled-banknote": "Close-up $100 bill printed text is AI-gibberish (qwen only; matches garbled-text class human validated as CAR-2)",
    "empty-counter": "Counter cutaways empty while characters were seated on both sides of the cut (qwen x2)",
    "third-hand": "Extra/third hand appears at the cups table (qwen, pro)",
    "coin-appearance": "Coin/token changes gold->silver and coins shift on the mat (qwen x2, gemma)",
    "cup-arrangement": "Cups snap from triangle to straight row without manipulation (pro x2)",
    "boomerang-loop": "man-in-mirror motion is a looped few frames played forward/back (pro; consistent with hand-teleport cluster)",
    "audio-desync": "Scratching sound doesn't match visible strokes (pro; audio claim, easy for human to verify)",
    "hand-teleport": "Grooming hand/tool teleports cheek->head->cheek instantly (pro x2, gemma x4)",
    "hand-jumpcuts": "Child's hands teleport across cuts around the bowl (pro x3)",
    "red-bag-vanish": "Background pedestrian's red bag vanishes from their hand (flash, pro x2)",
    "rim-clipping": "Poured olives render in front of receiving jar's near rim, wrong depth order (pro x4)",
    "board-vanish": "Skateboard dissolves under rider at landing (pro x2)",
    "background-morph": "Skatepark trees/light poles morph and vanish between tricks (pro x2)",
    "fruit-color": "Market fruit turns unnatural cyan/teal (flash, qwen)",
    "garbled-sign": "Market sign shows garbled glyphs (qwen; garbled-text class)",
    "driverless-motion": "Car moves at speed with the only occupant leaning out the window, nobody driving (flash, qwen)",
    "wind-inconsistency": "Wind blows hair violently but vegetation/antenna unaffected (gemma, pro)",
    "bowtie-necktie": "Magician wears black bow tie AND red necktie simultaneously (qwen; VERIFIED in frames by Claude)"
  },

